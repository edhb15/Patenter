# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patenter

# Signs access tokens. Use a long random value (at least 32 characters),
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
# backend/.env must use the same value.
JWT_ACCESS_SECRET=

# Lets the backend spend users' credits (/internal/credits/*). Another long
# random value; backend/.env must use the same value.
INTERNAL_API_SECRET=

# Optional
PORT=3000
NODE_ENV=development
# Extra browser origins that may call the API (comma-separated). Not needed
# when the site is served through deploy/Caddyfile (same origin).
# ALLOWED_ORIGINS=
# Refresh cookie is HTTPS-only when NODE_ENV=production; override with true/false
# COOKIE_SECURE=
# Set to the number of reverse-proxy hops (e.g. 1) when behind a proxy
# TRUST_PROXY=

# Stripe billing (optional; leave STRIPE_SECRET_KEY empty to switch it off).
# `npm run stripe:setup -- https://your-domain` prints the other values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_MAX=
# STRIPE_PORTAL_CONFIGURATION=
# STRIPE_AUTOMATIC_TAX=false
# Public address of the site, where Stripe sends people back to
# PUBLIC_URL=https://patenter.example

# Only used by `npm run seed`
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
