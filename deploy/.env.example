# Copy to ../.env (next to docker-compose.yml) and fill in.

# Domain the site is served on. Point its DNS A/AAAA record at the server;
# Caddy then gets an HTTPS certificate automatically.
DOMAIN=patenter.example

# Database password (any long random value).
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=

# Lets the API spend users' credits in the auth service. At least 32 random
# characters, different from JWT_ACCESS_SECRET (generate it the same way).
INTERNAL_API_SECRET=

# EPO Open Patent Services credentials (https://developers.epo.org).
CONSUMER_KEY=
CONSUMER_SECRET=

# OpenRouter key for Patenter AI and patent summaries.
OPENROUTER_API_KEY=

# ---- Stripe (paid plans) ------------------------------------------------
# Optional: with STRIPE_SECRET_KEY empty, nobody can buy a plan and you change
# plans by hand. To switch billing on, see "Payments" in deploy/README.md: the
# setup script prints every value below except the secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PORTAL_CONFIGURATION=
# true once Stripe Tax is set up in the Stripe dashboard (adds VAT/sales tax).
STRIPE_AUTOMATIC_TAX=false

# Comma-separated OpenRouter models, tried in order. Users send unpublished
# inventions here: use paid models from providers that don't log or train on
# prompts, and enable zero-data-retention in your OpenRouter settings.
# Leave empty to use the free testing models built into the backend.
AI_MODELS=
