# EPO OPS API credentials
CONSUMER_KEY=
CONSUMER_SECRET=

# OpenRouter key, used by /chat and patent summaries. Server-side only.
OPENROUTER_API_KEY=

# Must be the same value as JWT_ACCESS_SECRET in auth/.env
JWT_ACCESS_SECRET=

# Must be the same value as INTERNAL_API_SECRET in auth/.env. Every AI
# reply, search and comparison is paid for with the user's credits there.
INTERNAL_API_SECRET=

# Optional
PORT=3001
# Where the auth service runs (reached directly, not through the proxy)
AUTH_INTERNAL_URL=http://localhost:3000
# Public address of the site (sent to OpenRouter for attribution)
PUBLIC_URL=https://patenter.example
# Comma-separated OpenRouter models, tried in order. Use paid models from
# providers that don't log or train on prompts; see server.js.
# AI_MODELS=
# Extra browser origins that may call the API (comma-separated). Not needed
# when the site is served through deploy/Caddyfile (same origin).
# ALLOWED_ORIGINS=
# Set to the number of reverse-proxy hops (e.g. 1) when behind a proxy
# TRUST_PROXY=
