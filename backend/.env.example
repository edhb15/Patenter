# EPO OPS API credentials
CONSUMER_KEY=
CONSUMER_SECRET=

# OpenRouter key, used by /chat and patent summaries. Server-side only.
OPENROUTER_API_KEY=

# Must be the same value as JWT_ACCESS_SECRET in auth/.env
JWT_ACCESS_SECRET=

# Optional
PORT=3001
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set to the number of reverse-proxy hops (e.g. 1) when behind a proxy
# TRUST_PROXY=
